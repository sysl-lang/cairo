// Cairo for sysl — 2D vector graphics, bound to https://www.cairographics.org/.
//
// There is no `dependencies` block because this binding depends on no other sysl package. What it
// needs is a C library the machine already has, and `@link("cairo")` in the `c` module is where
// that is said — the same arrangement as `sqlite3` and the SDL3 packages, and the opposite of
// `plutovg`, `qoi` and `qcbor`, which carry their C with them.
//
// This is the block a *consumer* writes to reach this package, and resolution for it is built
// (`design/packages.md` §§ 3-6): a `sysl build` fetches the coordinate, selects by MVS, checks what
// arrived against `sysl.sum`, and compiles it as more modules.
//
//     dependencies {
//       cairo { git = "github.com/sysl-lang/cairo", version = "0.3.1" }
//     }
//
// The coordinate is identity rather than a URL, so it carries no `https://`, and the version is the
// tag `v0.3.1` on this repository.
//
// Cairo has to be installed, **and so do its headers**:
//
//     brew install cairo                 # macOS
//     sudo apt install libcairo2-dev     # Debian / Ubuntu
//
// The headers are read because `sh.sysl.cairo.c` asks the C compiler for cairo's own constants
// rather than transcribing them. There is still no shim and no `.c` file here. On a Homebrew machine
// that is two flags, one for each end:
//
//     sysl build . --link-path /opt/homebrew/lib --include-path cairo=/opt/homebrew/include/cairo

package {
  name    = "cairo"
  version = "0.3.1"
}

// Cairo is a hosted library. It opens files — a PNG, a PDF, an SVG — and reaches the C runtime for
// them, so a freestanding target has nothing for it to run on, and saying so here turns "this will
// not link" into one clean refusal before anything is compiled.
//
// `heap` is honest rather than defensive: cairo mallocs its surfaces, its paths and its glyph
// caches, and unlike QOI it has no allocator hook to point somewhere else. `image_surface_for_data`
// keeps the *pixels* out of the heap, which is the large allocation, but the surface object itself
// still allocates.
//
// A program that needs graphics without either of these wants `sh.sysl.plutovg`, which vendors its
// C and runs on a microcontroller. That is the real division between the two packages, and it is
// not about features.
requires {
  os    = true
  heap  = true

  // `sh.sysl.cairo.c` asks the C compiler for cairo's constants rather than transcribing them, so
  // the headers are read at compile time and not only at link time. Saying so here turns a forgotten
  // include path into one refusal naming cairo, rather than clang's "'cairo.h' file not found" — a
  // file the caller never wrote and has no way to place. The sentence is the whole point of the key:
  // it is read by someone who does not yet know what this package needs.
  headers {
    cairo = "cairo's own headers — `brew install cairo` puts them in /opt/homebrew/include/cairo, and Debian's libcairo2-dev in /usr/include/cairo"
  }
}
