// Fonts — the three objects underneath `Context.select_font_face`.
//
// A **font face** is a typeface with no size: "Georgia bold italic". A **scaled font** is a face
// with a size, a transform and a set of options resolved into one thing, which is what actually
// measures and draws. **Font options** are the rendering choices — antialiasing, hinting, subpixel
// order — that a scaled font is made with.
//
// A program using `select_font_face` and `set_font_size` never meets any of them, because cairo
// makes the scaled font itself. They matter when the same font is measured many times and the work
// is worth doing once, or when text has to be measured with no context to hand.
//
// **There is no `font_face` constructor here**, because every way of *making* one is backend
// specific: `cairo_ft_font_face_create_for_ft_face` needs FreeType, the Quartz one needs Core Text.
// That is a second library on the link line and therefore a separate package, by the same rule that
// made SDL3 four of them. What this module has is the face cairo already chose, out of
// `Context.font_face`.

module sh.sysl.cairo

import sh.sysl.cairo.c
import sysl.text.cstring

// A typeface with no size. Obtained from a context rather than constructed.
struct FontFace
    handle: *c.FontFace

    status(&self) -> Status = Status.of(c.font_face_status(self.handle))
    ok(&self) -> bool = self.status().ok()

    // Which backend made it. A face from `select_font_face` is `FontType.Toy`, whatever the platform
    // resolved it to underneath.
    kind(&self) -> FontType = FontType.of(c.font_face_get_type(self.handle))

    reference_count(&self) -> uint = c.font_face_get_reference_count(self.handle)
end FontFace

impl Drop for FontFace
    drop(self) = c.font_face_destroy(self.handle)

// A face, a size, a transform and a set of options, resolved into the thing that draws.
struct ScaledFont
    handle: *c.ScaledFont

    status(&self) -> Status = Status.of(c.scaled_font_status(self.handle))
    ok(&self) -> bool = self.status().ok()

    // The face it was made from. Cairo lends it, so a reference is taken before it is wrapped and
    // what comes back owns a share like anything else.
    face(&self) -> &FontFace =
        FontFace(c.font_face_reference(c.scaled_font_get_font_face(self.handle)))

    // The font's own metrics, with no string involved.
    extents(&self) -> FontExtents
        var e = font_extents()

        c.scaled_font_extents(self.handle, e.ptr())
        e
    end extents

    // What a string would occupy — the measurement a layout engine wants, with no context needed.
    text_extents(&self, text: string) -> TextExtents
        var t = cstring(text)
        var e = text_extents()

        c.scaled_font_text_extents(self.handle, t.ptr, e.ptr())
        e
    end text_extents
end ScaledFont

impl Drop for ScaledFont
    drop(self) = c.scaled_font_destroy(self.handle)

// How glyphs are to be rendered. Every setting has a `Default` that means "whatever the platform
// says", which is normally what you want — these exist for the cases where it is not.
struct FontOptions
    handle: *c.FontOptions

    status(&self) -> Status = Status.of(c.font_options_status(self.handle))
    ok(&self) -> bool = self.status().ok()

    // An independent copy.
    copy(&self) -> &FontOptions = FontOptions(c.font_options_copy(self.handle))

    // Take every setting of `other` that is not `Default`, leaving the rest alone.
    merge(&self, other: &FontOptions) = c.font_options_merge(self.handle, other.handle)

    // Whether two sets of options would render identically.
    equal(&self, other: &FontOptions) -> bool = c.font_options_equal(self.handle, other.handle)

    hash(&self) -> u64 = c.font_options_hash(self.handle)

    set_antialias(&self, antialias: Antialias) =
        c.font_options_set_antialias(self.handle, antialias.code())
    antialias(&self) -> Antialias = Antialias.of(c.font_options_get_antialias(self.handle))

    // Which way the subpixels of the display are ordered, for `Antialias.Subpixel`. Wrong here and
    // text acquires coloured fringes.
    set_subpixel_order(&self, order: SubpixelOrder) =
        c.font_options_set_subpixel_order(self.handle, order.code())
    subpixel_order(&self) -> SubpixelOrder =
        SubpixelOrder.of(c.font_options_get_subpixel_order(self.handle))

    // How far outlines are distorted to line up with the pixel grid. Sharper at small sizes and
    // less faithful to the design; `HintStyle.Off` is what a PDF wants.
    set_hint_style(&self, style: HintStyle) =
        c.font_options_set_hint_style(self.handle, style.code())
    hint_style(&self) -> HintStyle = HintStyle.of(c.font_options_get_hint_style(self.handle))

    // Whether *metrics* are rounded to whole pixels too. Turning this off is what makes text scale
    // smoothly in an animation, at the cost of blurrier stems.
    set_hint_metrics(&self, metrics: HintMetrics) =
        c.font_options_set_hint_metrics(self.handle, metrics.code())
    hint_metrics(&self) -> HintMetrics =
        HintMetrics.of(c.font_options_get_hint_metrics(self.handle))
end FontOptions

impl Drop for FontOptions
    drop(self) = c.font_options_destroy(self.handle)

// A fresh set of options, every one of them `Default`.
font_options() -> &FontOptions = FontOptions(c.font_options_create())

// A face at a size, ready to measure and draw with.
//
// `font_matrix` carries the size — `identity()` scaled by the point size is the usual one — and
// `ctm` is the transform the text will be drawn under, which cairo needs in order to hint against
// the right pixel grid.
scaled_font(face: &FontFace, font_matrix: Matrix, ctm: Matrix, options: &FontOptions) -> &ScaledFont
    var fm = font_matrix
    var cm = ctm

    ScaledFont(c.scaled_font_create(face.handle, fm.ptr(), cm.ptr(), options.handle))
end scaled_font
