// Cairo for sysl — 2D vector graphics: paths, filling, stroking, dashing, gradients, clipping,
// transforms and text, rendered into memory or straight into a PDF, an SVG or a PostScript file.
//
// ## The shape of it
//
// A `Surface` is where drawing lands. A `Context` draws on one. Between `move_to` and `fill` you
// build a path, and the context carries the state — source, line width, transform, clip, font — that
// the fill or stroke uses.
//
//     var s = image_surface(Format.Argb32, 200, 200)
//     var cr = context(s)
//
//     cr.set_source_rgb(0.1, 0.2, 0.9)
//     cr.arc(100.0, 100.0, 60.0, 0.0, 2.0 * pi)
//     cr.fill()
//
//     s.write_png("circle.png")
//
// **The same drawing code writes a PDF**, because only the first line changes:
//
//     var s = pdf_surface("out.pdf", 612.0, 792.0)
//
// That is the reason to reach for cairo over `sh.sysl.plutovg`, which rasterizes and stops there.
// The other reason is the opposite one: plutovg carries its own C and asks for no system library, so
// it runs on a microcontroller, and cairo does not. Neither replaces the other.
//
// ## Nothing is closed by hand
//
// There is no `destroy` in this API. `Surface`, `Context`, `Pattern`, `FontFace`, `ScaledFont` and
// `FontOptions` each hold a C allocation, each is reached through `&T`, and each has an `impl Drop`
// that releases it when the last reference goes. Cairo's objects are reference counted and so is
// `&T`, so the two agree: a surface handed to a pattern outlives the variable it was made in,
// because the pattern took a count of its own.
//
// **A handle cairo lends rather than gives — `Context.target`, `.source`, `.font_face` — is
// referenced before it is wrapped**, so what comes back owns a share like anything else. The
// previous shape of this package could only warn about those in a comment; there is nothing left to
// warn about.
//
// ## Errors live on the object
//
// This is cairo's most distinctive convention and the binding keeps it rather than translating it.
// Almost nothing answers a status: a call that fails **records** the failure on the context or the
// surface, and every later call on that object does nothing. So a program draws a whole page without
// checking anything and asks once at the end:
//
//     if !cr.status().ok()
//         print(cr.status())
//
// The reason this is safe rather than sloppy is that the failure is **sticky** — it cannot be
// overwritten by a later success, so the one check at the end sees the first thing that went wrong.
// Cairo's own documentation calls this "shielding" the caller from error checking.
//
// **A constructor never answers null**, for the same reason. When cairo cannot make a surface it
// answers a static "nil" object whose `status()` says why and which ignores everything asked of it,
// so there is no `Option` here — ask `ok()` if you want to know.

module sh.sysl.cairo

import sh.sysl.cairo.c
import sysl.text.from_cstring

// ## The enumerations
//
// **Each of cairo's enumerations is a sysl enum**, so a wrong one cannot be passed: `set_operator`
// takes an `Operator` and there is no way to hand it a `Filter`, or a bare `3`. The previous shape
// of this package made them all `const … : int` on the argument that they cross to C as `int` and an
// enum would need converting at every call. **The conversion turned out to be one `match` per type
// and the type safety is worth more than it costs** — these are `int`s in the same sense that a C
// pointer is an integer.
//
// Every one of them carries the same two members: `code(self)` for the number C wants, and an
// associated `of(code)` for the number C gave. `Other` exists on the enums cairo can *answer* so
// that a newer cairo reporting something this binding has not heard of keeps a program running and
// printing, rather than stopping at a `match` with no arm for it.
//
// The values themselves were **checked against `cairo.h` by compiling them**, all 138 of them, and
// they agree. They are still transcribed rather than asked of the C compiler: a `c const` block
// would make this package compile C for the first time, which turns "install libcairo" into "install
// the development headers and pass an include path". That trade is worth making deliberately and is
// not made here.

// What has gone wrong, as cairo reports it. Sticky, and shared by every kind of object:
// `Context.status`, `Surface.status`, `Pattern.status` and `FontOptions.status` all answer one.
enum Status
    Success
    NoMemory
    InvalidRestore
    InvalidPopGroup
    NoCurrentPoint
    InvalidMatrix
    InvalidStatus
    NullPointer
    InvalidString
    InvalidPathData
    ReadError
    WriteError
    SurfaceFinished
    SurfaceTypeMismatch
    PatternTypeMismatch
    InvalidContent
    InvalidFormat
    InvalidVisual
    FileNotFound
    InvalidDash

    // A failure this binding does not name. Cairo has some sixty of them and the twenty above are
    // the ones a drawing program meets; the number is kept so `message` is still cairo's own
    // sentence for exactly this failure.
    Other(code: int)

    // Nothing has gone wrong. The only value a program normally tests.
    ok(self) -> bool = self.code() == 0

    // Cairo's own sentence for it — "out of memory", "invalid matrix (not invertible)", and so on.
    // The string is a static one inside the library, so nothing here owns it.
    message(self) -> string =
        from_cstring(c.status_to_string(self.code())).unwrap_or("an error cairo could not describe")

    code(self) -> int
        self match
            Success -> c.STATUS_SUCCESS
            NoMemory -> c.STATUS_NO_MEMORY
            InvalidRestore -> c.STATUS_INVALID_RESTORE
            InvalidPopGroup -> c.STATUS_INVALID_POP_GROUP
            NoCurrentPoint -> c.STATUS_NO_CURRENT_POINT
            InvalidMatrix -> c.STATUS_INVALID_MATRIX
            InvalidStatus -> c.STATUS_INVALID_STATUS
            NullPointer -> c.STATUS_NULL_POINTER
            InvalidString -> c.STATUS_INVALID_STRING
            InvalidPathData -> c.STATUS_INVALID_PATH_DATA
            ReadError -> c.STATUS_READ_ERROR
            WriteError -> c.STATUS_WRITE_ERROR
            SurfaceFinished -> c.STATUS_SURFACE_FINISHED
            SurfaceTypeMismatch -> c.STATUS_SURFACE_TYPE_MISMATCH
            PatternTypeMismatch -> c.STATUS_PATTERN_TYPE_MISMATCH
            InvalidContent -> c.STATUS_INVALID_CONTENT
            InvalidFormat -> c.STATUS_INVALID_FORMAT
            InvalidVisual -> c.STATUS_INVALID_VISUAL
            FileNotFound -> c.STATUS_FILE_NOT_FOUND
            InvalidDash -> c.STATUS_INVALID_DASH
            Other(n) -> n

    of(code: int) -> Status
        code match
            c.STATUS_SUCCESS -> Success
            c.STATUS_NO_MEMORY -> NoMemory
            c.STATUS_INVALID_RESTORE -> InvalidRestore
            c.STATUS_INVALID_POP_GROUP -> InvalidPopGroup
            c.STATUS_NO_CURRENT_POINT -> NoCurrentPoint
            c.STATUS_INVALID_MATRIX -> InvalidMatrix
            c.STATUS_INVALID_STATUS -> InvalidStatus
            c.STATUS_NULL_POINTER -> NullPointer
            c.STATUS_INVALID_STRING -> InvalidString
            c.STATUS_INVALID_PATH_DATA -> InvalidPathData
            c.STATUS_READ_ERROR -> ReadError
            c.STATUS_WRITE_ERROR -> WriteError
            c.STATUS_SURFACE_FINISHED -> SurfaceFinished
            c.STATUS_SURFACE_TYPE_MISMATCH -> SurfaceTypeMismatch
            c.STATUS_PATTERN_TYPE_MISMATCH -> PatternTypeMismatch
            c.STATUS_INVALID_CONTENT -> InvalidContent
            c.STATUS_INVALID_FORMAT -> InvalidFormat
            c.STATUS_INVALID_VISUAL -> InvalidVisual
            c.STATUS_FILE_NOT_FOUND -> FileNotFound
            c.STATUS_INVALID_DASH -> InvalidDash
            n -> Other(n)
end Status

// So that `print(s)` and `f"$s"` say the sentence rather than the number.
impl Display for Status
    display(self, out: *Writer, fmt: FormatSpec) = display_str(self.message(), out, fmt)

// How the pixels of an image surface are laid out. `Argb32` is premultiplied and is what you want
// unless you know otherwise; `Rgb24` is the same 32 bits with the alpha byte unused.
enum Format
    Invalid
    Argb32
    Rgb24
    A8
    A1
    Rgb16_565
    Rgb30
    Rgb96f
    Rgba128f
    Other(code: int)

    code(self) -> int
        self match
            Invalid -> c.FORMAT_INVALID
            Argb32 -> c.FORMAT_ARGB32
            Rgb24 -> c.FORMAT_RGB24
            A8 -> c.FORMAT_A8
            A1 -> c.FORMAT_A1
            Rgb16_565 -> c.FORMAT_RGB16_565
            Rgb30 -> c.FORMAT_RGB30
            Rgb96f -> c.FORMAT_RGB96F
            Rgba128f -> c.FORMAT_RGBA128F
            Other(n) -> n

    of(code: int) -> Format
        code match
            c.FORMAT_INVALID -> Invalid
            c.FORMAT_ARGB32 -> Argb32
            c.FORMAT_RGB24 -> Rgb24
            c.FORMAT_A8 -> A8
            c.FORMAT_A1 -> A1
            c.FORMAT_RGB16_565 -> Rgb16_565
            c.FORMAT_RGB30 -> Rgb30
            c.FORMAT_RGB96F -> Rgb96f
            c.FORMAT_RGBA128F -> Rgba128f
            n -> Other(n)

    // The row length cairo requires for this format at a width, which is `width * bytes` rounded up
    // to whatever alignment the machine wants. Negative for a format cairo does not know.
    stride_for_width(self, width: int) -> int = c.format_stride_for_width(self.code(), width)
end Format

impl Display for Format
    display(self, out: *Writer, fmt: FormatSpec)
        val s = self match
            Invalid -> "invalid"
            Argb32 -> "argb32"
            Rgb24 -> "rgb24"
            A8 -> "a8"
            A1 -> "a1"
            Rgb16_565 -> "rgb16-565"
            Rgb30 -> "rgb30"
            Rgb96f -> "rgb96f"
            Rgba128f -> "rgba128f"
            Other(n) -> "an unknown format"

        display_str(s, out, fmt)

// What a surface holds, where the format is the backend's business rather than the caller's.
enum Content
    Color
    Alpha
    ColorAlpha
    Other(code: int)

    code(self) -> int
        self match
            Color -> c.CONTENT_COLOR
            Alpha -> c.CONTENT_ALPHA
            ColorAlpha -> c.CONTENT_COLOR_ALPHA
            Other(n) -> n

    of(code: int) -> Content
        code match
            c.CONTENT_COLOR -> Color
            c.CONTENT_ALPHA -> Alpha
            c.CONTENT_COLOR_ALPHA -> ColorAlpha
            n -> Other(n)
end Content

// How the source is combined with what is already there. `Over` is the default and is ordinary
// alpha compositing; the second half of the list is the Porter-Duff and blend-mode set.
enum Operator
    Clear
    Source
    Over
    In
    Out
    Atop
    Dest
    DestOver
    DestIn
    DestOut
    DestAtop
    Xor
    Add
    Saturate
    Multiply
    Screen
    Overlay
    Darken
    Lighten
    ColorDodge
    ColorBurn
    HardLight
    SoftLight
    Difference
    Exclusion
    HslHue
    HslSaturation
    HslColor
    HslLuminosity
    Other(code: int)

    code(self) -> int
        self match
            Clear -> c.OPERATOR_CLEAR
            Source -> c.OPERATOR_SOURCE
            Over -> c.OPERATOR_OVER
            In -> c.OPERATOR_IN
            Out -> c.OPERATOR_OUT
            Atop -> c.OPERATOR_ATOP
            Dest -> c.OPERATOR_DEST
            DestOver -> c.OPERATOR_DEST_OVER
            DestIn -> c.OPERATOR_DEST_IN
            DestOut -> c.OPERATOR_DEST_OUT
            DestAtop -> c.OPERATOR_DEST_ATOP
            Xor -> c.OPERATOR_XOR
            Add -> c.OPERATOR_ADD
            Saturate -> c.OPERATOR_SATURATE
            Multiply -> c.OPERATOR_MULTIPLY
            Screen -> c.OPERATOR_SCREEN
            Overlay -> c.OPERATOR_OVERLAY
            Darken -> c.OPERATOR_DARKEN
            Lighten -> c.OPERATOR_LIGHTEN
            ColorDodge -> c.OPERATOR_COLOR_DODGE
            ColorBurn -> c.OPERATOR_COLOR_BURN
            HardLight -> c.OPERATOR_HARD_LIGHT
            SoftLight -> c.OPERATOR_SOFT_LIGHT
            Difference -> c.OPERATOR_DIFFERENCE
            Exclusion -> c.OPERATOR_EXCLUSION
            HslHue -> c.OPERATOR_HSL_HUE
            HslSaturation -> c.OPERATOR_HSL_SATURATION
            HslColor -> c.OPERATOR_HSL_COLOR
            HslLuminosity -> c.OPERATOR_HSL_LUMINOSITY
            Other(n) -> n

    of(code: int) -> Operator
        code match
            c.OPERATOR_CLEAR -> Clear
            c.OPERATOR_SOURCE -> Source
            c.OPERATOR_OVER -> Over
            c.OPERATOR_IN -> In
            c.OPERATOR_OUT -> Out
            c.OPERATOR_ATOP -> Atop
            c.OPERATOR_DEST -> Dest
            c.OPERATOR_DEST_OVER -> DestOver
            c.OPERATOR_DEST_IN -> DestIn
            c.OPERATOR_DEST_OUT -> DestOut
            c.OPERATOR_DEST_ATOP -> DestAtop
            c.OPERATOR_XOR -> Xor
            c.OPERATOR_ADD -> Add
            c.OPERATOR_SATURATE -> Saturate
            c.OPERATOR_MULTIPLY -> Multiply
            c.OPERATOR_SCREEN -> Screen
            c.OPERATOR_OVERLAY -> Overlay
            c.OPERATOR_DARKEN -> Darken
            c.OPERATOR_LIGHTEN -> Lighten
            c.OPERATOR_COLOR_DODGE -> ColorDodge
            c.OPERATOR_COLOR_BURN -> ColorBurn
            c.OPERATOR_HARD_LIGHT -> HardLight
            c.OPERATOR_SOFT_LIGHT -> SoftLight
            c.OPERATOR_DIFFERENCE -> Difference
            c.OPERATOR_EXCLUSION -> Exclusion
            c.OPERATOR_HSL_HUE -> HslHue
            c.OPERATOR_HSL_SATURATION -> HslSaturation
            c.OPERATOR_HSL_COLOR -> HslColor
            c.OPERATOR_HSL_LUMINOSITY -> HslLuminosity
            n -> Other(n)
end Operator

// How edges are smoothed. `Default` lets cairo choose for the backend.
enum Antialias
    Default
    Off
    Gray
    Subpixel
    Fast
    Good
    Best
    Other(code: int)

    code(self) -> int
        self match
            Default -> c.ANTIALIAS_DEFAULT
            Off -> c.ANTIALIAS_NONE
            Gray -> c.ANTIALIAS_GRAY
            Subpixel -> c.ANTIALIAS_SUBPIXEL
            Fast -> c.ANTIALIAS_FAST
            Good -> c.ANTIALIAS_GOOD
            Best -> c.ANTIALIAS_BEST
            Other(n) -> n

    of(code: int) -> Antialias
        code match
            c.ANTIALIAS_DEFAULT -> Default
            c.ANTIALIAS_NONE -> Off
            c.ANTIALIAS_GRAY -> Gray
            c.ANTIALIAS_SUBPIXEL -> Subpixel
            c.ANTIALIAS_FAST -> Fast
            c.ANTIALIAS_GOOD -> Good
            c.ANTIALIAS_BEST -> Best
            n -> Other(n)
end Antialias

// How a path decides what is inside it when it crosses itself.
enum FillRule
    Winding
    EvenOdd
    Other(code: int)

    code(self) -> int
        self match
            Winding -> c.FILL_RULE_WINDING
            EvenOdd -> c.FILL_RULE_EVEN_ODD
            Other(n) -> n

    of(code: int) -> FillRule
        code match
            c.FILL_RULE_WINDING -> Winding
            c.FILL_RULE_EVEN_ODD -> EvenOdd
            n -> Other(n)
end FillRule

// How a stroke ends.
enum LineCap
    Butt
    Round
    Square
    Other(code: int)

    code(self) -> int
        self match
            Butt -> c.LINE_CAP_BUTT
            Round -> c.LINE_CAP_ROUND
            Square -> c.LINE_CAP_SQUARE
            Other(n) -> n

    of(code: int) -> LineCap
        code match
            c.LINE_CAP_BUTT -> Butt
            c.LINE_CAP_ROUND -> Round
            c.LINE_CAP_SQUARE -> Square
            n -> Other(n)
end LineCap

// How two segments of a stroke meet.
enum LineJoin
    Miter
    Round
    Bevel
    Other(code: int)

    code(self) -> int
        self match
            Miter -> c.LINE_JOIN_MITER
            Round -> c.LINE_JOIN_ROUND
            Bevel -> c.LINE_JOIN_BEVEL
            Other(n) -> n

    of(code: int) -> LineJoin
        code match
            c.LINE_JOIN_MITER -> Miter
            c.LINE_JOIN_ROUND -> Round
            c.LINE_JOIN_BEVEL -> Bevel
            n -> Other(n)
end LineJoin

enum FontSlant
    Normal
    Italic
    Oblique
    Other(code: int)

    code(self) -> int
        self match
            Normal -> c.FONT_SLANT_NORMAL
            Italic -> c.FONT_SLANT_ITALIC
            Oblique -> c.FONT_SLANT_OBLIQUE
            Other(n) -> n

    of(code: int) -> FontSlant
        code match
            c.FONT_SLANT_NORMAL -> Normal
            c.FONT_SLANT_ITALIC -> Italic
            c.FONT_SLANT_OBLIQUE -> Oblique
            n -> Other(n)
end FontSlant

enum FontWeight
    Normal
    Bold
    Other(code: int)

    code(self) -> int
        self match
            Normal -> c.FONT_WEIGHT_NORMAL
            Bold -> c.FONT_WEIGHT_BOLD
            Other(n) -> n

    of(code: int) -> FontWeight
        code match
            c.FONT_WEIGHT_NORMAL -> Normal
            c.FONT_WEIGHT_BOLD -> Bold
            n -> Other(n)
end FontWeight

// The order of the coloured stripes in a pixel, for subpixel antialiasing.
enum SubpixelOrder
    Default
    Rgb
    Bgr
    Vrgb
    Vbgr
    Other(code: int)

    code(self) -> int
        self match
            Default -> c.SUBPIXEL_ORDER_DEFAULT
            Rgb -> c.SUBPIXEL_ORDER_RGB
            Bgr -> c.SUBPIXEL_ORDER_BGR
            Vrgb -> c.SUBPIXEL_ORDER_VRGB
            Vbgr -> c.SUBPIXEL_ORDER_VBGR
            Other(n) -> n

    of(code: int) -> SubpixelOrder
        code match
            c.SUBPIXEL_ORDER_DEFAULT -> Default
            c.SUBPIXEL_ORDER_RGB -> Rgb
            c.SUBPIXEL_ORDER_BGR -> Bgr
            c.SUBPIXEL_ORDER_VRGB -> Vrgb
            c.SUBPIXEL_ORDER_VBGR -> Vbgr
            n -> Other(n)
end SubpixelOrder

// How far glyph outlines are distorted to line up with the pixel grid.
enum HintStyle
    Default
    Off
    Slight
    Medium
    Full
    Other(code: int)

    code(self) -> int
        self match
            Default -> c.HINT_STYLE_DEFAULT
            Off -> c.HINT_STYLE_NONE
            Slight -> c.HINT_STYLE_SLIGHT
            Medium -> c.HINT_STYLE_MEDIUM
            Full -> c.HINT_STYLE_FULL
            Other(n) -> n

    of(code: int) -> HintStyle
        code match
            c.HINT_STYLE_DEFAULT -> Default
            c.HINT_STYLE_NONE -> Off
            c.HINT_STYLE_SLIGHT -> Slight
            c.HINT_STYLE_MEDIUM -> Medium
            c.HINT_STYLE_FULL -> Full
            n -> Other(n)
end HintStyle

// Whether glyph advances are rounded to whole pixels — off is what a PDF wants, on is what a screen
// wants.
enum HintMetrics
    Default
    Off
    On
    Other(code: int)

    code(self) -> int
        self match
            Default -> c.HINT_METRICS_DEFAULT
            Off -> c.HINT_METRICS_OFF
            On -> c.HINT_METRICS_ON
            Other(n) -> n

    of(code: int) -> HintMetrics
        code match
            c.HINT_METRICS_DEFAULT -> Default
            c.HINT_METRICS_OFF -> Off
            c.HINT_METRICS_ON -> On
            n -> Other(n)
end HintMetrics

// What a pattern does outside the area it was defined for. A gradient defaults to `Pad` and a
// surface to `None`.
enum Extend
    Nothing
    Repeat
    Reflect
    Pad
    Other(code: int)

    code(self) -> int
        self match
            Nothing -> c.EXTEND_NONE
            Repeat -> c.EXTEND_REPEAT
            Reflect -> c.EXTEND_REFLECT
            Pad -> c.EXTEND_PAD
            Other(n) -> n

    of(code: int) -> Extend
        code match
            c.EXTEND_NONE -> Nothing
            c.EXTEND_REPEAT -> Repeat
            c.EXTEND_REFLECT -> Reflect
            c.EXTEND_PAD -> Pad
            n -> Other(n)
end Extend

// How a surface pattern is sampled when it is not at its natural size. `Nearest` is what pixel art
// wants; `Good` is the default.
enum Filter
    Fast
    Good
    Best
    Nearest
    Bilinear
    Gaussian
    Other(code: int)

    code(self) -> int
        self match
            Fast -> c.FILTER_FAST
            Good -> c.FILTER_GOOD
            Best -> c.FILTER_BEST
            Nearest -> c.FILTER_NEAREST
            Bilinear -> c.FILTER_BILINEAR
            Gaussian -> c.FILTER_GAUSSIAN
            Other(n) -> n

    of(code: int) -> Filter
        code match
            c.FILTER_FAST -> Fast
            c.FILTER_GOOD -> Good
            c.FILTER_BEST -> Best
            c.FILTER_NEAREST -> Nearest
            c.FILTER_BILINEAR -> Bilinear
            c.FILTER_GAUSSIAN -> Gaussian
            n -> Other(n)
end Filter

// What `Surface.kind` answers. Only the ones this package can produce are named; cairo has a dozen
// more for window systems it was built against.
enum SurfaceType
    Image
    Pdf
    Ps
    Svg
    Recording
    Other(code: int)

    code(self) -> int
        self match
            Image -> c.SURFACE_TYPE_IMAGE
            Pdf -> c.SURFACE_TYPE_PDF
            Ps -> c.SURFACE_TYPE_PS
            Svg -> c.SURFACE_TYPE_SVG
            Recording -> c.SURFACE_TYPE_RECORDING
            Other(n) -> n

    of(code: int) -> SurfaceType
        code match
            c.SURFACE_TYPE_IMAGE -> Image
            c.SURFACE_TYPE_PDF -> Pdf
            c.SURFACE_TYPE_PS -> Ps
            c.SURFACE_TYPE_SVG -> Svg
            c.SURFACE_TYPE_RECORDING -> Recording
            n -> Other(n)
end SurfaceType

impl Display for SurfaceType
    display(self, out: *Writer, fmt: FormatSpec)
        val s = self match
            Image -> "image"
            Pdf -> "pdf"
            Ps -> "postscript"
            Svg -> "svg"
            Recording -> "recording"
            Other(n) -> "another backend"

        display_str(s, out, fmt)

enum PatternType
    Solid
