end FontType

// ## The vector backends' own values

enum PdfVersion
    V1_4
    V1_5
    V1_6
    V1_7
    Other(code: int)

    code(self) -> int
        self match
            V1_4 -> c.PDF_VERSION_1_4
            V1_5 -> c.PDF_VERSION_1_5
            V1_6 -> c.PDF_VERSION_1_6
            V1_7 -> c.PDF_VERSION_1_7
            Other(n) -> n

    // The name of a PDF version, as `"PDF 1.7"`.
    name(self) -> string =
        from_cstring(c.pdf_version_to_string(self.code())).unwrap_or("unknown")
end PdfVersion

impl Display for PdfVersion
    display(self, out: *Writer, fmt: FormatSpec) = display_str(self.name(), out, fmt)

// One of the document's standard metadata fields.
enum PdfMetadata
    Title
    Author
    Subject
    Keywords
    Creator
    CreateDate
    ModDate

    code(self) -> int
        self match
            Title -> c.PDF_METADATA_TITLE
            Author -> c.PDF_METADATA_AUTHOR
            Subject -> c.PDF_METADATA_SUBJECT
            Keywords -> c.PDF_METADATA_KEYWORDS
            Creator -> c.PDF_METADATA_CREATOR
            CreateDate -> c.PDF_METADATA_CREATE_DATE
            ModDate -> c.PDF_METADATA_MOD_DATE
end PdfMetadata

enum SvgVersion
    V1_1
    V1_2
    Other(code: int)

