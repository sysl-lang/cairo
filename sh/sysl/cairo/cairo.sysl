impl Display for SvgVersion
    display(self, out: *Writer, fmt: FormatSpec) = display_str(self.name(), out, fmt)

// How a bookmark appears in the viewer's sidebar. **A set rather than a choice**, so it is a struct
// with `|` rather than an enum: `OutlineFlags.bold() | OutlineFlags.open()` is the pair of them.
struct OutlineFlags
    bits: int

    // Expanded when the document opens, rather than collapsed.
    open() -> OutlineFlags = OutlineFlags(c.PDF_OUTLINE_FLAG_OPEN)
    bold() -> OutlineFlags = OutlineFlags(c.PDF_OUTLINE_FLAG_BOLD)
    italic() -> OutlineFlags = OutlineFlags(c.PDF_OUTLINE_FLAG_ITALIC)

    // No flags at all, which is the ordinary entry.
    plain() -> OutlineFlags = OutlineFlags(0)
end OutlineFlags

impl BitOr for OutlineFlags
    bitor(self, rhs: OutlineFlags) -> OutlineFlags = OutlineFlags(self.bits | rhs.bits)

// ## Tag names for `Context.tag_begin`
//
// Cairo gives two of these a meaning of its own; everything else is a PDF structure tag and is
// written as its own string.

// A hyperlink, whose attributes name a `uri=` or a `dest=`.
const TAG_LINK: string = "Link"

// A named destination a link can point at, as `name='top' x=72 y=72`.
const TAG_DEST: string = "cairo.dest"

// The words cairo puts on `Context.tag_begin` for readable text that is not what the glyphs say.
const TAG_CONTENT: string = "cairo.content"
const TAG_CONTENT_REF: string = "cairo.content_ref"

// ## The library itself

// Which cairo this program is linked against, as its own three-part string.
version() -> string = from_cstring(c.version_string()).unwrap_or("unknown")

// The same, encoded as `major * 10000 + minor * 100 + micro`, which is what a comparison wants.
version_number() -> int = c.version()

// ## Comparing and printing them
//
// Every enum above answers `==` and prints as a word rather than a number, so a test reads
// `assert_eq(cr.line_cap(), LineCap.Round)` and a diagnostic says `round`. Equality is by the code
// C uses, which is what makes `Other(1)` from an older cairo equal to the variant a newer binding
// would have named.
//
// **A simple enum needs no block** — with no variant carrying anything its value *is* its
// discriminant, so `==` is already that comparison and the compiler refuses a hand-written one.
// `PdfMetadata` is the only one here in that position; every other enum has an `Other` arm.

impl Eq for Status
    eq(self, rhs: Status) -> bool = self.code() == rhs.code()

impl Eq for Format
    eq(self, rhs: Format) -> bool = self.code() == rhs.code()

impl Eq for Content
    eq(self, rhs: Content) -> bool = self.code() == rhs.code()

impl Eq for Operator
    eq(self, rhs: Operator) -> bool = self.code() == rhs.code()

impl Eq for Antialias
    eq(self, rhs: Antialias) -> bool = self.code() == rhs.code()

impl Eq for FillRule
    eq(self, rhs: FillRule) -> bool = self.code() == rhs.code()

impl Eq for LineCap
    eq(self, rhs: LineCap) -> bool = self.code() == rhs.code()

impl Eq for LineJoin
    eq(self, rhs: LineJoin) -> bool = self.code() == rhs.code()

impl Eq for FontSlant
    eq(self, rhs: FontSlant) -> bool = self.code() == rhs.code()

impl Eq for FontWeight
    eq(self, rhs: FontWeight) -> bool = self.code() == rhs.code()

impl Eq for SubpixelOrder
    eq(self, rhs: SubpixelOrder) -> bool = self.code() == rhs.code()

impl Eq for HintStyle
    eq(self, rhs: HintStyle) -> bool = self.code() == rhs.code()

impl Eq for HintMetrics
    eq(self, rhs: HintMetrics) -> bool = self.code() == rhs.code()

impl Eq for Extend
    eq(self, rhs: Extend) -> bool = self.code() == rhs.code()

impl Eq for Filter
    eq(self, rhs: Filter) -> bool = self.code() == rhs.code()

impl Eq for SurfaceType
    eq(self, rhs: SurfaceType) -> bool = self.code() == rhs.code()

impl Eq for PatternType
    eq(self, rhs: PatternType) -> bool = self.code() == rhs.code()

impl Eq for FontType
    eq(self, rhs: FontType) -> bool = self.code() == rhs.code()

impl Eq for PdfVersion
    eq(self, rhs: PdfVersion) -> bool = self.code() == rhs.code()


impl Eq for SvgVersion
    eq(self, rhs: SvgVersion) -> bool = self.code() == rhs.code()

impl Display for Content
    display(self, out: *Writer, fmt: FormatSpec)
        val s = self match
            Color -> "colour"
            Alpha -> "alpha"
            ColorAlpha -> "colour and alpha"
            Other(n) -> "an unknown value"

        display_str(s, out, fmt)

impl Display for Operator
    display(self, out: *Writer, fmt: FormatSpec)
        val s = self match
            Clear -> "clear"
            Source -> "source"
            Over -> "over"
            In -> "in"
            Out -> "out"
            Atop -> "atop"
            Dest -> "dest"
            DestOver -> "dest-over"
            DestIn -> "dest-in"
            DestOut -> "dest-out"
            DestAtop -> "dest-atop"
            Xor -> "xor"
            Add -> "add"
            Saturate -> "saturate"
            Multiply -> "multiply"
            Screen -> "screen"
            Overlay -> "overlay"
            Darken -> "darken"
            Lighten -> "lighten"
            ColorDodge -> "colour-dodge"
            ColorBurn -> "colour-burn"
            HardLight -> "hard-light"
            SoftLight -> "soft-light"
            Difference -> "difference"
            Exclusion -> "exclusion"
            HslHue -> "hsl-hue"
            HslSaturation -> "hsl-saturation"
            HslColor -> "hsl-colour"
            HslLuminosity -> "hsl-luminosity"
            Other(n) -> "an unknown value"

        display_str(s, out, fmt)

