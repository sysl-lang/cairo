            c.PATTERN_TYPE_SURFACE -> SurfacePattern
            c.PATTERN_TYPE_LINEAR -> Linear
            c.PATTERN_TYPE_RADIAL -> Radial
            c.PATTERN_TYPE_MESH -> Mesh
