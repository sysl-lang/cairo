// Patterns — everything that can be a source other than a flat colour.
//
// A pattern is a function from a point to a colour. Four kinds are made here: a solid colour, the
// contents of another surface, a linear gradient and a radial one. `Context.pop_group` produces a
// fifth by recording drawing into one.
//
// A pattern has a **matrix of its own**, which maps user space to *pattern* space — so it is the
// inverse of what the name suggests. Scaling a pattern's matrix by two makes the pattern appear
// half the size, because the point being asked about is scaled, not the pattern.

module sh.sysl.cairo

import sh.sysl.cairo.externs

// A source. Made by one of the constructors below, and released with `destroy`.
struct Pattern
    handle: *u8

    status(self) -> Status = Status(externs.pattern_status(self.handle))
    ok(self) -> bool = self.status().ok()

    // Which of the kinds this is, as a `PATTERN_TYPE_*` value.
    kind(self) -> int = externs.pattern_get_type(self.handle)

    reference(self) -> Pattern = Pattern(externs.pattern_reference(self.handle))

    // Add a colour stop to a gradient, at `offset` along it — 0 at the start and 1 at the end.
    // Stops may be added in any order, and two at the same offset make a hard edge.
    //
    // Recorded as `STATUS_PATTERN_TYPE_MISMATCH` if the pattern is not a gradient.
    add_color_stop_rgb(*self, offset: real, red: real, green: real, blue: real) =
        externs.pattern_add_color_stop_rgb(self.handle, offset, red, green, blue)

    add_color_stop_rgba(*self, offset: real, red: real, green: real, blue: real, alpha: real) =
        externs.pattern_add_color_stop_rgba(self.handle, offset, red, green, blue, alpha)

    // How many stops a gradient has. `None` where the pattern is not a gradient.
    color_stop_count(self) -> Option[int]
        var n = 0

        if externs.pattern_get_color_stop_count(self.handle, &n) == 0 then Some(n) else None
    end color_stop_count

    // What happens outside the pattern's own area — nothing, tiling, mirrored tiling, or the edge
    // colour smeared outwards. A gradient defaults to `EXTEND_PAD` and a surface to `EXTEND_NONE`.
    set_extend(*self, extend: int) = externs.pattern_set_extend(self.handle, extend)
    extend(self) -> int = externs.pattern_get_extend(self.handle)

    // How a surface pattern is sampled when it is not at its natural size. `FILTER_NEAREST` is what
    // pixel art wants; `FILTER_GOOD` is the default.
    set_filter(*self, filter: int) = externs.pattern_set_filter(self.handle, filter)
    filter(self) -> int = externs.pattern_get_filter(self.handle)

    // The pattern's own matrix, which maps **user space to pattern space** — so to draw an image at
    // twice its size, scale this by a half.
    set_matrix(*self, matrix: Matrix)
        var m = matrix

        externs.pattern_set_matrix(self.handle, m.ptr())
    end set_matrix

    matrix(self) -> Matrix
        var m = identity()

        externs.pattern_get_matrix(self.handle, m.ptr())
        m
    end matrix

    // Release one reference. Destroying twice is harmless — the handle is nulled.
    destroy(*self)
        if self.handle != null
            externs.pattern_destroy(self.handle)
            self.handle = null
end Pattern

// A flat colour, as a pattern. Worth making only where a pattern is what is wanted — for a plain
// fill, `Context.set_source_rgb` is the same thing with nothing to destroy.
solid_pattern(red: real, green: real, blue: real) -> Pattern =
    Pattern(externs.pattern_create_rgb(red, green, blue))

solid_pattern_rgba(red: real, green: real, blue: real, alpha: real) -> Pattern =
    Pattern(externs.pattern_create_rgba(red, green, blue, alpha))

// The contents of a surface, as a source. Takes a reference to the surface, so it may be destroyed
// while the pattern still uses it.
surface_pattern(surface: Surface) -> Pattern =
    Pattern(externs.pattern_create_for_surface(surface.handle))

// A gradient along the line from `(x0, y0)` to `(x1, y1)`. It has no colour until stops are added.
linear_pattern(x0: real, y0: real, x1: real, y1: real) -> Pattern =
    Pattern(externs.pattern_create_linear(x0, y0, x1, y1))

// A gradient between two circles, which is how a highlight is drawn: a small circle inside a large
// one, offset towards where the light is.
radial_pattern(cx0: real, cy0: real, radius0: real, cx1: real, cy1: real, radius1: real) -> Pattern =
    Pattern(externs.pattern_create_radial(cx0, cy0, radius0, cx1, cy1, radius1))
