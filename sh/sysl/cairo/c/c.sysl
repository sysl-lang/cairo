extern "cairo_font_extents" font_extents(cr: *Cairo, extents: *real)

// A glyph is `{ unsigned long index; double x; double y; }` — not homogeneous, so it is passed as a
// pointer to the caller's own array of the matching sysl struct rather than as a `*real`.
extern "cairo_show_glyphs" show_glyphs(cr: *Cairo, glyphs: *u8, num_glyphs: int)
