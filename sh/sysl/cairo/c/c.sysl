// ## Text — the "toy" API, and the glyph one under it
//
// `select_font_face` and `show_text` are cairo's own words for a text interface that does no
// shaping: it is enough for a label and not enough for Arabic. `show_glyphs` is the layer beneath,
// where a shaping engine has already decided which glyph goes where.

extern "cairo_select_font_face" select_font_face(cr: *Cairo, family: *u8, slant: int, weight: int)
extern "cairo_set_font_size" set_font_size(cr: *Cairo, size: real)
