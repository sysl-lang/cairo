// ## The handles
//
// Cairo publishes no layout for any of these, so each is an `opaque struct` (`15 §9`) and is reached
// only through a pointer. **That is what stops one being passed where another is wanted**: every
// handle here was a `*u8` until this package took its second shape, and with one type for all six
// `cairo_surface_destroy(pattern)` type-checked perfectly and corrupted the heap. Six distinct types
// cost nothing at run time — a pointer is a pointer — and the compiler now refuses the mix-up.
//
// All six are **reference counted**. A `_create` answers a count of one, a `_reference` adds one and
// a `_destroy` drops one; the object goes when the count reaches zero. A creation that failed is not
// null — cairo answers a static "nil" object instead, whose `_status` reports what went wrong and
// which ignores every call made on it. That is why nothing here answers a nullable pointer.

opaque struct Cairo
opaque struct Surface
opaque struct Pattern
opaque struct FontFace
opaque struct ScaledFont
opaque struct FontOptions

// ## The drawing context — `cairo_t`

extern "cairo_create" create(target: *Surface) -> *Cairo
extern "cairo_reference" reference(cr: *Cairo) -> *Cairo
extern "cairo_destroy" destroy(cr: *Cairo)
extern "cairo_get_reference_count" get_reference_count(cr: *Cairo) -> uint
extern "cairo_status" status(cr: *Cairo) -> int
extern "cairo_status_to_string" status_to_string(status: int) -> *u8
extern "cairo_save" save(cr: *Cairo)
extern "cairo_restore" restore(cr: *Cairo)
extern "cairo_get_target" get_target(cr: *Cairo) -> *Surface
extern "cairo_get_group_target" get_group_target(cr: *Cairo) -> *Surface

// ### Groups
//
// A group redirects drawing to an intermediate surface, which `pop_group` hands back as a pattern —
// the way a composite of several operations is given one opacity, or one mask.

extern "cairo_push_group" push_group(cr: *Cairo)
extern "cairo_push_group_with_content" push_group_with_content(cr: *Cairo, content: int)
extern "cairo_pop_group" pop_group(cr: *Cairo) -> *Pattern
extern "cairo_pop_group_to_source" pop_group_to_source(cr: *Cairo)

// ### The source, and the rest of the graphics state

extern "cairo_set_source" set_source(cr: *Cairo, source: *Pattern)
extern "cairo_set_source_rgb" set_source_rgb(cr: *Cairo, red: real, green: real, blue: real)
extern "cairo_set_source_rgba" set_source_rgba(cr: *Cairo, red: real, green: real, blue: real, alpha: real)
extern "cairo_set_source_surface" set_source_surface(cr: *Cairo, surface: *Surface, x: real, y: real)
extern "cairo_get_source" get_source(cr: *Cairo) -> *Pattern

extern "cairo_set_operator" set_operator(cr: *Cairo, op: int)
extern "cairo_get_operator" get_operator(cr: *Cairo) -> int
extern "cairo_set_tolerance" set_tolerance(cr: *Cairo, tolerance: real)
extern "cairo_get_tolerance" get_tolerance(cr: *Cairo) -> real
extern "cairo_set_antialias" set_antialias(cr: *Cairo, antialias: int)
extern "cairo_get_antialias" get_antialias(cr: *Cairo) -> int
extern "cairo_set_fill_rule" set_fill_rule(cr: *Cairo, fill_rule: int)
extern "cairo_get_fill_rule" get_fill_rule(cr: *Cairo) -> int

extern "cairo_set_line_width" set_line_width(cr: *Cairo, width: real)
