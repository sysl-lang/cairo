extern "cairo_image_surface_create_from_png_stream" image_surface_create_from_png_stream(read_func: *extern (*u8, *u8, uint) -> int, closure: *u8) -> *Surface

// ### The vector backends
//
// PDF, SVG and PostScript are compiled into libcairo itself, so they need no second library on the
// link line and are part of this package rather than a companion to it.

