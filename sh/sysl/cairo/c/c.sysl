// ### PNG
//
// The two stream forms hand cairo a function to call with each block of bytes, and an opaque
// `closure` pointer it passes straight back — which is how a PNG is encoded into memory rather than
// onto disk.

extern "cairo_surface_write_to_png" surface_write_to_png(surface: *Surface, filename: *u8) -> int
