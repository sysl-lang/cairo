// Cairo's own surface, declared verbatim.
//
// **Nothing here is meant to be called by a program.** Every name and every convention is C's: a
// context is a raw pointer, a matrix is six doubles behind a pointer, a string is a NUL-terminated
// `*u8`. The modules beside this one turn those into sysl and are what an application imports.
//
// The split keeps two jobs apart. This one has to be **faithful** — a signature that disagrees with
// the C header links perfectly and corrupts the call at run time, and nothing in this arrangement
// checks one against the other, so each declaration below was read out of `cairo.h` rather than
// remembered. The other one has to be **pleasant**, which is a different question and would
// otherwise be answered in the same breath.
//
// **Not one public function in cairo takes or returns a struct by value**, which was checked by
// walking every `cairo_public` declaration in the header rather than by reading a few of them: the
// only non-scalar parameters in the whole library are enums, which are `int`s, and function
// pointers. So there is no shim in this package at all, and the `UsefulBufC` problem that reshaped
// qcbor's entire API simply does not arise.
//
// The structs cairo does have — a matrix, the two kinds of extents, a glyph — are always written
// through a pointer into storage the *caller* owns, which is the house pattern and needs nothing
// from the language beyond taking a struct's address.

module sh.sysl.cairo.externs
@link("cairo")

// ## The drawing context — `cairo_t`
//
// Reference counted. `cairo_create` answers a context with a count of one, and `cairo_destroy` drops
// one; a count that reaches zero frees it. A context whose creation failed is not null — cairo
// answers a static "nil" object instead, whose `cairo_status` reports what went wrong and which
// ignores every drawing call made on it. That is why nothing here answers a nullable pointer.

extern "cairo_create" create(target: *u8) -> *u8
extern "cairo_reference" reference(cr: *u8) -> *u8
extern "cairo_destroy" destroy(cr: *u8)
extern "cairo_get_reference_count" get_reference_count(cr: *u8) -> uint
extern "cairo_status" status(cr: *u8) -> int
extern "cairo_status_to_string" status_to_string(status: int) -> *u8
extern "cairo_save" save(cr: *u8)
extern "cairo_restore" restore(cr: *u8)
extern "cairo_get_target" get_target(cr: *u8) -> *u8
extern "cairo_get_group_target" get_group_target(cr: *u8) -> *u8

// ### Groups
//
// A group redirects drawing to an intermediate surface, which `pop_group` hands back as a pattern —
// the way a composite of several operations is given one opacity, or one mask.

extern "cairo_push_group" push_group(cr: *u8)
extern "cairo_push_group_with_content" push_group_with_content(cr: *u8, content: int)
extern "cairo_pop_group" pop_group(cr: *u8) -> *u8
extern "cairo_pop_group_to_source" pop_group_to_source(cr: *u8)

