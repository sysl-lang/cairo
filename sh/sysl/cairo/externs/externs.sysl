extern "cairo_set_source" set_source(cr: *u8, source: *u8)
extern "cairo_set_source_rgb" set_source_rgb(cr: *u8, red: real, green: real, blue: real)
extern "cairo_set_source_rgba" set_source_rgba(cr: *u8, red: real, green: real, blue: real, alpha: real)
extern "cairo_set_source_surface" set_source_surface(cr: *u8, surface: *u8, x: real, y: real)
extern "cairo_get_source" get_source(cr: *u8) -> *u8

extern "cairo_set_operator" set_operator(cr: *u8, op: int)
extern "cairo_get_operator" get_operator(cr: *u8) -> int
extern "cairo_set_tolerance" set_tolerance(cr: *u8, tolerance: real)
extern "cairo_get_tolerance" get_tolerance(cr: *u8) -> real
extern "cairo_set_antialias" set_antialias(cr: *u8, antialias: int)
extern "cairo_get_antialias" get_antialias(cr: *u8) -> int
extern "cairo_set_fill_rule" set_fill_rule(cr: *u8, fill_rule: int)
extern "cairo_get_fill_rule" get_fill_rule(cr: *u8) -> int

extern "cairo_set_line_width" set_line_width(cr: *u8, width: real)
extern "cairo_get_line_width" get_line_width(cr: *u8) -> real
extern "cairo_set_line_cap" set_line_cap(cr: *u8, line_cap: int)
extern "cairo_get_line_cap" get_line_cap(cr: *u8) -> int
