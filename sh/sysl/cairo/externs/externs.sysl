// ## Text — the "toy" API, and the glyph one under it
//
// `select_font_face` and `show_text` are cairo's own words for a text interface that does no
// shaping: it is enough for a label and not enough for Arabic. `show_glyphs` is the layer beneath,
// where a shaping engine has already decided which glyph goes where.

extern "cairo_select_font_face" select_font_face(cr: *u8, family: *u8, slant: int, weight: int)
extern "cairo_set_font_size" set_font_size(cr: *u8, size: real)
extern "cairo_set_font_matrix" set_font_matrix(cr: *u8, matrix: *real)
extern "cairo_get_font_matrix" get_font_matrix(cr: *u8, matrix: *real)
extern "cairo_set_font_options" set_font_options(cr: *u8, options: *u8)
extern "cairo_get_font_options" get_font_options(cr: *u8, options: *u8)
extern "cairo_set_font_face" set_font_face(cr: *u8, font_face: *u8)
extern "cairo_get_font_face" get_font_face(cr: *u8) -> *u8
extern "cairo_set_scaled_font" set_scaled_font(cr: *u8, scaled_font: *u8)
extern "cairo_get_scaled_font" get_scaled_font(cr: *u8) -> *u8
extern "cairo_show_text" show_text(cr: *u8, utf8: *u8)
extern "cairo_text_path" text_path(cr: *u8, utf8: *u8)
extern "cairo_text_extents" text_extents(cr: *u8, utf8: *u8, extents: *real)
extern "cairo_font_extents" font_extents(cr: *u8, extents: *real)

// A glyph is `{ unsigned long index; double x; double y; }` — not homogeneous, so it is passed as a
// pointer to the caller's own array of the matching sysl struct rather than as a `*real`.
extern "cairo_show_glyphs" show_glyphs(cr: *u8, glyphs: *u8, num_glyphs: int)
extern "cairo_glyph_path" glyph_path(cr: *u8, glyphs: *u8, num_glyphs: int)
extern "cairo_glyph_extents" glyph_extents(cr: *u8, glyphs: *u8, num_glyphs: int, extents: *real)

